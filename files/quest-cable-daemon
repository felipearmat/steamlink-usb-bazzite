#!/bin/bash
# Steam Link VR over USB: sends the video through the USB cable whenever possible, keeping the
# headset's Wi-Fi on (controllers, sign-in, discovery). Runs as the quest-cable user service, in
# desktop mode or in the gamescope session.
#
# - No Quest on USB, no adb or the Steam Link app closed: does nothing (Wi-Fi left alone).
# - App open with the cable plugged in: keeps the headset in USB networking (NCM) mode; Horizon OS
#   sometimes switches back to MTP on its own, which removes the USB network.
# - Links LegacySteamRuntime into the default Steam library when Steam installed it elsewhere
#   (otherwise SteamVR's compositor never starts).
# - While a Quest is plugged in and awake: turns the PC's screen on and holds an idle inhibitor
#   (keeps the session active). With the screen off (DPMS) Steam answers discovery but the
#   headset never sends its connection request, and Steam's update window hangs the client.
# - Current SteamVR ("Uber link", 2.18+) streams over every link at once, cable included, and
#   breaks if the Wi-Fi link is blocked (vrlink restarts its Wi-Fi socket every second and the
#   image freezes). So by default (BLOCK_WIFI_VIDEO=auto) the Wi-Fi video is only blocked for an
#   older vrlink without Uber link: then only when this vrserver's session is up, the headset has
#   been streaming for STREAM_SETTLE seconds and the cable answers, and it is unblocked at once
#   when any of that stops being true.
set -u

CONF="${QUEST_CABLE_CONF:-$HOME/.config/quest-cable.conf}"
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"
: "${ADB:=adb}"
: "${HEADSET_IP:=10.86.13.37}"
: "${STEAM_DIR:=$HOME/.local/share/Steam}"
: "${NCM_MIN_INTERVAL:=15}"   # s between NCM switches (each one re-enumerates the headset's USB)
: "${STREAM_SETTLE:=8}"       # s streaming before blocking the Wi-Fi video
: "${BLOCK_WIFI_VIDEO:=auto}" # auto (only without Uber link), yes or no
: "${KEEP_SCREEN_ON:=yes}"    # wake the screen and inhibit idle while Steam Link is in use
export PATH="$HOME/.local/bin:/home/linuxbrew/.linuxbrew/bin:$PATH"

PKG=com.valvesoftware.steamlinkvr
QUEST_VENDOR=2833
FW=/usr/local/bin/quest-wifi-video-block
VRSERVER_LOG="$STEAM_DIR/logs/vrserver.txt"
STATE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/quest-cable.blocked-ip"

log() { echo "$*"; }

aq() { timeout 5 "$ADB" shell "$@" 2>/dev/null | tr -d '\r'; }
quest_on_usb() { grep -qx "$QUEST_VENDOR" /sys/bus/usb/devices/*/idVendor 2>/dev/null; }
adb_ok() { [ "$(timeout 5 "$ADB" get-state 2>/dev/null)" = device ]; }
app_running() { [ -n "$(aq pidof "$PKG")" ]; }
streaming() { aq "dumpsys activity activities | grep ResumedActivity" | grep -q "steamlink.VRLink"; }
# Headset in use: awake (a headset taken off or left charging goes to sleep within minutes).
headset_awake() { aq "dumpsys power | grep -m1 mWakefulness=" | grep -q Awake; }
wifi_ip() { aq ip -4 -br addr show wlan0 | awk '{print $3}' | cut -d/ -f1; }

# Network interface of the headset's NCM function (name depends on the machine).
quest_iface() {
  local n
  for n in /sys/class/net/*; do
    [ "$(cat "$(readlink -f "$n/device")/../idVendor" 2>/dev/null)" = "$QUEST_VENDOR" ] &&
      { basename "$n"; return 0; }
  done
  return 1
}
cable_ok() {
  local i
  i=$(quest_iface) || return 1
  ping -c1 -W1 -I "$i" "$HEADSET_IP" >/dev/null 2>&1
}

# vrserver.txt accumulates several runs: only a "Found primary link" after this vrserver's
# startup line counts.
session_linked() {
  local pid
  pid=$(pgrep -x vrserver | head -1)
  [ -n "$pid" ] && awk -v s="startup with PID=$pid," \
    '/startup with PID=/ {on = index($0, s) > 0} on && /Found primary link/ {f=1} END {exit !f}' \
    "$VRSERVER_LOG" 2>/dev/null
}

# SteamVR's vrcompositor-launcher.sh looks for the LegacySteamRuntime tool only in Steam's
# default library. With SteamVR in another library, Steam installs the tool there (the first
# time SteamVR starts) and the compositor never starts: the stream drops right after
# connecting. Keep a symlink in the default library whenever the tool lives elsewhere.
ensure_legacy_runtime() {
  local want="$STEAM_DIR/steamapps/common/LegacySteamRuntime" lib
  [ -x "$want/legacy-steam-runtime" ] && return 0
  while read -r lib; do
    [ "$lib" = "$STEAM_DIR" ] && continue
    if [ -x "$lib/steamapps/common/LegacySteamRuntime/legacy-steam-runtime" ]; then
      mkdir -p "$STEAM_DIR/steamapps/common" &&
        ln -sfn "$lib/steamapps/common/LegacySteamRuntime" "$want" &&
        log "LegacySteamRuntime linked from $lib (SteamVR's compositor only looks in the default library)"
      return 0
    fi
  done < <(grep -oP '"path"\s*"\K[^"]+' "$STEAM_DIR/steamapps/libraryfolders.vdf" 2>/dev/null)
}

# True when this vrserver's vrlink runs the "Uber link" (all links at once, cable included).
uber_link() {
  local pid
  pid=$(pgrep -x vrserver | head -1)
  [ -n "$pid" ] && awk -v s="startup with PID=$pid," \
    '/startup with PID=/ {on = index($0, s) > 0} on && /Uber link enabled/ {f=1} END {exit !f}' \
    "$VRSERVER_LOG" 2>/dev/null
}
want_block() {
  case $BLOCK_WIFI_VIDEO in
    yes) return 0 ;;
    no) return 1 ;;
    *) ! uber_link ;;
  esac
}

# --- screen ------------------------------------------------------------------------------------
INHIBIT_PID=""
wake_screen() {
  local w
  command -v kscreen-doctor >/dev/null || return 0
  w=${WAYLAND_DISPLAY:-$(find "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" -maxdepth 1 -name 'wayland-[0-9]*' \
       ! -name '*.lock' -printf '%f\n' 2>/dev/null | head -1)}
  [ -n "$w" ] || return 0
  WAYLAND_DISPLAY=$w kscreen-doctor --dpms show 2>/dev/null | grep -q ': off' || return 0
  WAYLAND_DISPLAY=$w kscreen-doctor --dpms on >/dev/null 2>&1 && log "screen woken up (Quest connected and awake)"
}
hold_screen() {
  [ "$KEEP_SCREEN_ON" = yes ] || return 0
  wake_screen
  if [ -z "$INHIBIT_PID" ] || ! kill -0 "$INHIBIT_PID" 2>/dev/null; then
    systemd-inhibit --what=idle --who=quest-cable --mode=block \
      --why="Quest connected and awake" sleep infinity &
    INHIBIT_PID=$!
    log "keeping the session active and the screen on (Quest connected and awake)"
  fi
}
release_screen() {
  [ -n "$INHIBIT_PID" ] || return 0
  kill "$INHIBIT_PID" 2>/dev/null
  wait "$INHIBIT_PID" 2>/dev/null
  INHIBIT_PID=""
  log "screen released ($1)"
}

blocked_ip() { cat "$STATE" 2>/dev/null; }
block() {
  sudo -n "$FW" on "$1" && echo "$1" > "$STATE" &&
    log "video over USB (headset Wi-Fi $1 blocked on the video port)"
}
unblock() {
  local ip
  ip=$(blocked_ip)
  [ -n "$ip" ] || return 0
  sudo -n "$FW" off "$ip"
  rm -f "$STATE"
  log "Wi-Fi video unblocked ($1)"
}

trap 'unblock "service stopping"; release_screen "service stopping"; exit 0' TERM INT
unblock "leftover from a previous run"
log "waiting for the Quest (adb: $ADB, headset USB IP: $HEADSET_IP, block Wi-Fi video: $BLOCK_WIFI_VIDEO)"

last_ncm=0
stream_since=0
while :; do
  # Needed over Wi-Fi too, so before any cable check (only a stat when the link exists).
  ensure_legacy_runtime

  if ! quest_on_usb || ! adb_ok; then
    unblock "no Quest on USB/adb"
    release_screen "no Quest on USB/adb"
    stream_since=0
    sleep 5
    continue
  fi

  # Quest plugged in and awake: keep the PC session active and the screen on, so opening Steam
  # Link in the headset always finds a PC that answers.
  if headset_awake; then hold_screen; else release_screen "headset asleep"; fi

  if ! app_running; then
    unblock "Steam Link closed"
    stream_since=0
    sleep 5
    continue
  fi

  funcs=$(aq svc usb getFunctions)
  if [ -n "$funcs" ] && [[ $funcs != *ncm* ]]; then
    unblock "USB network down"
    now=$(date +%s)
    if (( now - last_ncm >= NCM_MIN_INTERVAL )); then
      log "headset USB in '$funcs' mode: switching back to USB networking (NCM)"
      aq svc usb setFunctions ncm >/dev/null
      last_ncm=$now
    fi
    sleep 3
    continue
  fi

  if streaming; then
    (( stream_since )) || stream_since=$(date +%s)
  else
    stream_since=0
  fi

  if (( stream_since )) && (( $(date +%s) - stream_since >= STREAM_SETTLE )) &&
     session_linked && want_block && cable_ok; then
    if [ -z "$(blocked_ip)" ]; then
      ip=$(wifi_ip)
      [ -n "$ip" ] && block "$ip"
    fi
  else
    unblock "not streaming, no session or cable not answering"
  fi
  sleep 2
done
